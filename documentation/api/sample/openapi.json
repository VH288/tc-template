{
  "components": {
    "responses": {
      "BadRequestError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "BAD_REQUEST",
                "message": "invalid request body"
              },
              "success": false
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Bad request (e.g. invalid JSON payload)"
      },
      "ConflictError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "CONFLICT",
                "message": "resource already exists"
              },
              "success": false
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Resource conflict or version mismatch"
      },
      "InternalServerError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "internal server error"
              },
              "success": false
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Internal server error"
      },
      "NotFoundError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "NOT_FOUND",
                "message": "resource not found"
              },
              "success": false
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Resource not found"
      },
      "UnauthorizedError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "UNAUTHORIZED",
                "message": "unauthorized"
              },
              "success": false
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Unauthorized (missing or invalid X-API-Key)"
      },
      "ValidationError": {
        "content": {
          "application/json": {
            "example": {
              "error": {
                "code": "VALIDATION_ERROR",
                "details": {
                  "name": "failed on 'min' validation"
                },
                "message": "validation failed"
              },
              "success": false
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        },
        "description": "Validation failed on request parameters or body"
      }
    },
    "schemas": {
      "CreateSampleRequest": {
        "properties": {
          "description": {
            "description": "Optional detailed description",
            "example": "VIP Pass",
            "maxLength": 500,
            "type": "string"
          },
          "name": {
            "description": "Name of the sample",
            "example": "Concert Ticket",
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "status": {
            "default": "active",
            "description": "Operational status (defaults to active)",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "DeleteSampleResponse": {
        "properties": {
          "data": {
            "example": null,
            "nullable": true
          },
          "message": {
            "example": "sample deleted",
            "type": "string"
          },
          "success": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "example": "VALIDATION_ERROR",
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "name": "failed on 'min' validation"
            },
            "type": "object"
          },
          "message": {
            "example": "validation failed",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "success": {
            "example": false,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      },
      "ListSampleResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "type": "array"
          },
          "message": {
            "example": "ok",
            "type": "string"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          },
          "success": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "data",
          "meta"
        ],
        "type": "object"
      },
      "PaginationMeta": {
        "properties": {
          "page": {
            "example": 1,
            "type": "integer"
          },
          "per_page": {
            "example": 10,
            "type": "integer"
          },
          "total": {
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "total_pages": {
            "example": 1,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Sample": {
        "properties": {
          "created_at": {
            "example": "2026-11-08T09:30:00Z",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "example": "VIP Pass",
            "type": "string"
          },
          "id": {
            "example": "7f000001-9310-1df0-8193-10bb4e9e0000",
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "example": "Concert Ticket",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "inactive"
            ],
            "example": "active",
            "type": "string"
          },
          "updated_at": {
            "example": "2026-11-08T09:30:00Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "status",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "SingleSampleResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Sample"
          },
          "message": {
            "example": "sample created",
            "type": "string"
          },
          "success": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "data"
        ],
        "type": "object"
      },
      "UpdateSampleRequest": {
        "properties": {
          "description": {
            "description": "Optional description",
            "example": "Updated VIP Pass",
            "maxLength": 500,
            "type": "string"
          },
          "name": {
            "description": "Name of the sample",
            "example": "Concert Ticket Updated",
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "status": {
            "description": "Operational status",
            "enum": [
              "active",
              "inactive"
            ],
            "example": "inactive",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "API Key authentication header. Bypassed in development mode when unconfigured.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "RESTful API documentation for Sample CRUD operations in tc-template.",
    "title": "Sample API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/samples": {
      "get": {
        "description": "Returns a paginated list of samples ordered by creation date descending.",
        "operationId": "listSamples",
        "parameters": [
          {
            "description": "Page number (starts at 1)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Items per page (clamped between 1 and 100)",
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "created_at": "2026-11-08T09:30:00Z",
                      "description": "VIP backstage access pass",
                      "id": "7f000001-9310-1df0-8193-10bb4e9e0000",
                      "name": "Rock Festival 2026 Ticket",
                      "status": "active",
                      "updated_at": "2026-11-08T09:30:00Z"
                    }
                  ],
                  "message": "ok",
                  "meta": {
                    "page": 1,
                    "per_page": 10,
                    "total": 1,
                    "total_pages": 1
                  },
                  "success": true
                },
                "schema": {
                  "$ref": "#/components/schemas/ListSampleResponse"
                }
              }
            },
            "description": "List of samples successfully retrieved"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "List samples"
      },
      "post": {
        "description": "Creates a new sample record.",
        "operationId": "createSample",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "description": "VIP backstage access pass",
                "name": "Rock Festival 2026 Ticket",
                "status": "active"
              },
              "schema": {
                "$ref": "#/components/schemas/CreateSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "created_at": "2026-11-08T09:30:00Z",
                    "description": "VIP backstage access pass",
                    "id": "7f000001-9310-1df0-8193-10bb4e9e0000",
                    "name": "Rock Festival 2026 Ticket",
                    "status": "active",
                    "updated_at": "2026-11-08T09:30:00Z"
                  },
                  "message": "sample created",
                  "success": true
                },
                "schema": {
                  "$ref": "#/components/schemas/SingleSampleResponse"
                }
              }
            },
            "description": "Sample successfully created"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Create sample"
      }
    },
    "/samples/{id}": {
      "delete": {
        "description": "Deletes a sample entity by UUID.",
        "operationId": "deleteSample",
        "parameters": [
          {
            "description": "Sample UUID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "7f000001-9310-1df0-8193-10bb4e9e0000",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": null,
                  "message": "sample deleted",
                  "success": true
                },
                "schema": {
                  "$ref": "#/components/schemas/DeleteSampleResponse"
                }
              }
            },
            "description": "Sample successfully deleted"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Delete sample"
      },
      "get": {
        "description": "Retrieves a single sample entity by its UUID.",
        "operationId": "getSampleByID",
        "parameters": [
          {
            "description": "Sample UUID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "7f000001-9310-1df0-8193-10bb4e9e0000",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "created_at": "2026-11-08T09:30:00Z",
                    "description": "VIP backstage access pass",
                    "id": "7f000001-9310-1df0-8193-10bb4e9e0000",
                    "name": "Rock Festival 2026 Ticket",
                    "status": "active",
                    "updated_at": "2026-11-08T09:30:00Z"
                  },
                  "message": "ok",
                  "success": true
                },
                "schema": {
                  "$ref": "#/components/schemas/SingleSampleResponse"
                }
              }
            },
            "description": "Sample found"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Get sample by ID"
      },
      "put": {
        "description": "Updates the name, description, and status of an existing sample entity.",
        "operationId": "updateSample",
        "parameters": [
          {
            "description": "Sample UUID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "7f000001-9310-1df0-8193-10bb4e9e0000",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "description": "VIP backstage access pass - allocation exhausted",
                "name": "Rock Festival 2026 Ticket - Sold Out",
                "status": "inactive"
              },
              "schema": {
                "$ref": "#/components/schemas/UpdateSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "created_at": "2026-11-08T09:30:00Z",
                    "description": "VIP backstage access pass - allocation exhausted",
                    "id": "7f000001-9310-1df0-8193-10bb4e9e0000",
                    "name": "Rock Festival 2026 Ticket - Sold Out",
                    "status": "inactive",
                    "updated_at": "2026-11-08T09:45:00Z"
                  },
                  "message": "sample updated",
                  "success": true
                },
                "schema": {
                  "$ref": "#/components/schemas/SingleSampleResponse"
                }
              }
            },
            "description": "Sample successfully updated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Update sample"
      }
    }
  },
  "servers": [
    {
      "description": "Local development server",
      "url": "http://localhost:8081/api/v1"
    }
  ]
}